/bin/
*.exe

# frontend build artifacts — regenerated by `wails build` / `npm install`
cmd/multipx-app/frontend/node_modules/
cmd/multipx-app/frontend/dist/
cmd/multipx-app/frontend/wailsjs/

# wails build output (build/darwin, build/windows etc. hold committed
