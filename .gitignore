# compiled binaries under build/bin are generated per-build)
cmd/multipx-app/build/bin/

# Rust build cache (native/ — earlier GPU-rendered client experiment)
native/target/

# throwaway verification scaffolding
.tmp-verify/

# OS cruft
.DS_Store
Thumbs.db
